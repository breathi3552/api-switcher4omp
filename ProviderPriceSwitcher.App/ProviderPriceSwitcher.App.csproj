<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ProviderPriceSwitcher.Core\ProviderPriceSwitcher.Core.csproj" />
    <ProjectReference Include="..\ProviderPriceSwitcher.Application\ProviderPriceSwitcher.Application.csproj" />
    <ProjectReference Include="..\ProviderPriceSwitcher.Adapters\ProviderPriceSwitcher.Adapters.csproj" />
    <ProjectReference Include="..\ProviderPriceSwitcher.Infrastructure\ProviderPriceSwitcher.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <NoWarn>$(NoWarn);CA1001;CA1305;CA1859;CA1861</NoWarn>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <None Include="Assets\Bifrost\bifrost-sidecar.exe" Link="bifrost-sidecar.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="Assets\Bifrost\bifrost-sidecar.manifest.json" Link="bifrost-sidecar.manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
