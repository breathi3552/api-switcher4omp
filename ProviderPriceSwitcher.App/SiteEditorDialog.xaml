<Window x:Class="ProviderPriceSwitcher.App.SiteEditorDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="供应商配置" Icon="Assets\AppIcon.ico">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
<GroupBox Header="基础配置"><StackPanel><TextBlock Text="站点类型" ToolTip="选择价格查询适配器；不同类型决定认证和价格接口格式。"/><ComboBox ItemsSource="{Binding Descriptors}" SelectedItem="{Binding Descriptor}" DisplayMemberPath="DisplayName"/><TextBlock Text="ProviderId（唯一标识）" ToolTip="供应商的稳定唯一标识；修改会迁移旧配置及关联凭据。"/><TextBox Text="{Binding ProviderId,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="显示名称（可选）" ToolTip="仅用于界面显示，不参与供应商身份匹配。"/><TextBox Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Base URL（价格接口地址）" ToolTip="供应商价格查询服务的根地址，必须是 http 或 https。"/><TextBox Text="{Binding BaseUrl,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="配置页面地址（可选）" ToolTip="首页双击站点时打开的路径。留空使用 Base URL/keys。"/><Grid><TextBox Text="{Binding ConfigurationApiAddress,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="/keys" IsHitTestVisible="False" Foreground="Gray" Margin="5,2,0,0" VerticalAlignment="Center"/></Grid></StackPanel></GroupBox>
<GroupBox Header="价格查询" Margin="0,12,0,0"><StackPanel><TextBlock Text="目标模型" ToolTip="用于价格查询的基准模型；不等于 OMP 请求最终使用的模型。"/><TextBox Text="{Binding Model,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="当前绑定分组（可输入或选择）" ToolTip="当前 API key 实际绑定的计费和权限分组。价格最低分组不会自动替换它。"/><ComboBox IsEditable="True" ItemsSource="{Binding GroupOptions}" Text="{Binding CurrentGroup,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="当前分组倍率" ToolTip="当前绑定分组相对基础价格的倍率，必须为大于 0 的数字。"/><TextBox Text="{Binding CurrentGroupRatio,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding ProbeMessage}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><Button Content="测试价格查询" Command="{Binding ProbeCommand}"/><Button Content="取消探测" Command="{Binding CancelProbeCommand}"/></StackPanel></StackPanel></GroupBox>
<GroupBox Header="站点凭据" Margin="0,12,0,0"><StackPanel><TextBlock Text="凭据状态" Foreground="Gray"/><TextBlock Text="{Binding CredentialSummary.StatusText}" Foreground="#777777" ToolTip="显示本地凭据是否已配置；不会显示令牌或 Cookie 原文。"/><TextBlock Text="访问令牌" ToolTip="填写供应商用于价格查询的 AccessToken/Bearer token；保存后只显示状态摘要。"/><PasswordBox x:Name="TokenBox" ToolTip="输入 AccessToken；保存后清空输入框。"/><TextBlock Text="Cookie" ToolTip="填写供应商网站登录态的完整 Cookie 请求头；保存后只显示状态摘要。"/><PasswordBox x:Name="CookieBox" ToolTip="粘贴完整 Cookie 请求头；保存后清空输入框。"/><StackPanel Orientation="Horizontal"><Button Content="绑定/更新站点凭据" Click="SaveCredentialClick"/><Button Content="清除站点凭据" Click="ClearCredentialClick"/></StackPanel></StackPanel></GroupBox>
<GroupBox Header="模型推理" Margin="0,12,0,0"><StackPanel><TextBlock Text="当前绑定分组（与价格查询共用）" ToolTip="保存模型推理 API key 时使用价格查询区域的当前绑定分组。"/><TextBlock Text="{Binding CurrentGroup}"/><TextBlock Text="模型推理 API key" ToolTip="输入新的模型推理 API key 会更新已保存 key；已保存 key 只显示脱敏摘要。"/><Grid><PasswordBox x:Name="InferenceKeyBox" ToolTip="输入新的模型推理 API key；留空不会改变已保存 key。" PasswordChanged="InferenceKeyBoxChanged"/><TextBlock x:Name="InferenceKeyPlaceholder" Text="{Binding InferenceKeySummary.MaskedKey,TargetNullValue=未配置}" IsHitTestVisible="False" Foreground="Gray" Margin="5,2,0,0" VerticalAlignment="Center"/></Grid><StackPanel Orientation="Horizontal"><Button Content="更新 API key" Click="SaveInferenceKeyClick"/><Button Content="删除 API key" Click="DeleteInferenceKeyClick"/></StackPanel><TextBlock Text="{Binding KeyActionMessage}" TextWrapping="Wrap"/></StackPanel></GroupBox>
<StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="保存" Command="{Binding SaveCommand}"/><Button Content="关闭" IsCancel="True"/></StackPanel>
</StackPanel></ScrollViewer></Window>