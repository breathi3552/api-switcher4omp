<Window x:Class="ProviderPriceSwitcher.App.SiteEditorDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="供应商配置" Icon="Assets\AppIcon.ico">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
<GroupBox Header="基础"><StackPanel><TextBlock Text="站点类型"/><ComboBox ItemsSource="{Binding Descriptors}" SelectedItem="{Binding Descriptor}" DisplayMemberPath="DisplayName"/><TextBlock Text="ProviderId"/><TextBox Text="{Binding ProviderId,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="显示名称"/><TextBox Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Base URL"/><TextBox Text="{Binding BaseUrl,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></GroupBox>
<GroupBox Header="价格查询" Margin="0,12,0,0"><StackPanel><TextBlock Text="目标模型"/><TextBox Text="{Binding Model,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="当前绑定分组"/><TextBox Text="{Binding CurrentGroup,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="当前分组倍率"/><TextBox Text="{Binding CurrentGroupRatio,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="站点凭据状态"/><TextBlock Text="{Binding CredentialSummary.StatusText}"/><PasswordBox x:Name="TokenBox"/><TextBox x:Name="CookieBox"/><StackPanel Orientation="Horizontal"><Button Content="绑定/更新站点凭据" Click="SaveCredentialClick"/><Button Content="清除站点凭据" Click="ClearCredentialClick"/></StackPanel></StackPanel></GroupBox>
<GroupBox Header="模型推理" Margin="0,12,0,0"><StackPanel><TextBlock Text="当前绑定分组"/><TextBox Text="{Binding InferenceBoundGroup,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="已保存 API key"/><TextBlock Text="{Binding InferenceKeySummary.MaskedKey}"/><PasswordBox x:Name="InferenceKeyBox"/><StackPanel Orientation="Horizontal"><Button Content="更新 API key" Click="SaveInferenceKeyClick"/><Button Content="删除 API key" Click="DeleteInferenceKeyClick"/></StackPanel></StackPanel></GroupBox>
<TextBlock Text="{Binding ProbeMessage}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><Button Content="测试价格查询" Command="{Binding ProbeCommand}"/><Button Content="取消探测" Command="{Binding CancelProbeCommand}"/><Button Content="保存" Command="{Binding SaveCommand}"/><Button Content="关闭" IsCancel="True"/></StackPanel>
</StackPanel></ScrollViewer></Window>
