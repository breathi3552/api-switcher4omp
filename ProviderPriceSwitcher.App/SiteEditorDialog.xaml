<Window x:Class="ProviderPriceSwitcher.App.SiteEditorDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="站点编辑" Icon="Assets\AppIcon.ico">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
<TextBlock Text="站点类型"/><ComboBox ItemsSource="{Binding Descriptors}" SelectedItem="{Binding Descriptor}" DisplayMemberPath="DisplayName"/>
<TextBlock Text="ProviderId"/><TextBox Text="{Binding ProviderId,UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="显示名称"/><TextBox Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="Base URL"/><TextBox Text="{Binding BaseUrl,UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="目标模型"/><TextBox Text="{Binding Model,UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="当前分组"/><TextBox Text="{Binding CurrentGroup,UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="当前分组倍率"/><TextBox Text="{Binding CurrentGroupRatio,UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="凭据状态"/><TextBlock Text="{Binding CredentialSummary.StatusText}"/>
<PasswordBox x:Name="TokenBox"/><TextBox x:Name="CookieBox"/>
<StackPanel Orientation="Horizontal"><Button Content="绑定/更新令牌" Click="SaveCredentialClick"/><Button Content="清除凭据" Click="ClearCredentialClick"/></StackPanel>
<TextBlock Text="{Binding ProbeMessage}" TextWrapping="Wrap"/>
<StackPanel Orientation="Horizontal"><Button Content="测试价格查询" Command="{Binding ProbeCommand}"/><Button Content="取消探测" Command="{Binding CancelProbeCommand}"/><Button Content="保存" Command="{Binding SaveCommand}"/><Button Content="关闭" IsCancel="True"/></StackPanel>
</StackPanel></ScrollViewer></Window>
