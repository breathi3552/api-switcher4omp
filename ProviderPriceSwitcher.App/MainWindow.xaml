<Window x:Class="ProviderPriceSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProviderPriceSwitcher.App"
        Title="ProviderPriceSwitcher" Icon="Assets\AppIcon.ico" Width="1420" Height="820" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Padding="20,16" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ProviderPriceSwitcher" FontSize="20" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,28,0"/>
                    <Button Content="检查价格" Command="{Binding CheckCommand}" IsDefault="True"/>
                    <Button Content="取消检查" Command="{Binding CancelCommand}"/>
                    <Button Content="管理站点" Command="{Binding ManageSitesCommand}"/>
                    <Button Content="设置" Command="{Binding SettingsCommand}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#52606D"/>
            </Grid>
        </Border>
        <Grid Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Padding="16" Background="White" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="5" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="当前 OMP Provider" Foreground="#6B7280"/><TextBlock Text="{Binding CurrentProvider}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="推荐 Provider" Foreground="#6B7280"/><TextBlock Text="{Binding RecommendedProvider}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal"><Ellipse x:Name="TakeoverStatusDot" Width="9" Height="9" Fill="{Binding TakeoverStatusBrush}" Margin="0,0,6,0"/><TextBlock Text="OMP 接管" Foreground="#6B7280"/></StackPanel>
                        <TextBlock Text="{Binding TakeoverStatus}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <StackPanel Orientation="Horizontal"><Ellipse x:Name="GatewayStatusDot" Width="9" Height="9" Fill="{Binding GatewayStatusBrush}" Margin="0,0,6,0"/><TextBlock Text="网关" Foreground="#6B7280"/></StackPanel>
                        <TextBlock Text="{Binding GatewayPortStatus}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="最近检查" Foreground="#6B7280"/><TextBlock Text="{Binding LastCheckedText}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </Border>
            <DataGrid Grid.Row="1" MouseDoubleClick="PriceGrid_MouseDoubleClick" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#D9DEE7" BorderThickness="1" Background="White">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSiteFirstRow}" Value="True"><Setter Property="Background" Value="#E8F1FB"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                            <DataTrigger Binding="{Binding HasWarning}" Value="True"><Setter Property="Background" Value="#FFF7ED"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsStale}" Value="True"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="站点" Binding="{Binding ProviderId}" Width="110"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="105"/>
                    <DataGridTextColumn Header="分组" Binding="{Binding Group}" Width="190"/>
                    <DataGridTextColumn Header="倍率" Binding="{Binding Ratio}" Width="70"/>
                    <DataGridTextColumn Header="输入单价" Binding="{Binding InputPrice}" Width="85"/>
                    <DataGridTextColumn Header="缓存输入单价" Binding="{Binding CachedPrice}" Width="105"/>
                    <DataGridTextColumn Header="输出单价" Binding="{Binding OutputPrice}" Width="85"/>
                    <DataGridTextColumn Header="预计成本" Binding="{Binding EstimatedCost}" Width="90"/>
                    <DataGridTextColumn Header="缓存命中率" Binding="{Binding CacheHitRate}" Width="95"/>
                    <DataGridTextColumn Header="倍率来源" Binding="{Binding RatioSource}" Width="85"/>
                    <DataGridTextColumn Header="检查时间" Binding="{Binding UpdatedAt}" Width="135"/>
                    <DataGridTextColumn Header="详情" Binding="{Binding Issue}" Width="*" MinWidth="150"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="2" Padding="16" Margin="0,16,0,0" Background="White" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="目标供应商" Foreground="#6B7280"/>
                        <ComboBox ItemsSource="{Binding ProviderChoices}" SelectedItem="{Binding SelectedProvider}" DisplayMemberPath="Display" ToolTip="{Binding SelectionHint}"/>
                        <TextBlock Text="{Binding SelectionHint}" Foreground="#9A6700" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="OMP 工作目录" Foreground="#6B7280"/>
                        <ComboBox x:Name="OmpWorkingDirectoryBox" ItemsSource="{Binding OmpWorkingDirectoryChoices}" SelectedItem="{Binding SelectedOmpWorkingDirectory,UpdateSourceTrigger=PropertyChanged}" ToolTip="选择本次启动 OMP 使用的工作目录。"/>
                    </StackPanel>
                    <Button x:Name="ApplyRouteButton" Grid.Column="2" Content="{Binding ApplyRouteButtonText}" Command="{Binding ApplyRouteCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                    <Button x:Name="StartOmpButton" Grid.Column="3" Content="{Binding StartOmpButtonText}" Command="{Binding StartOmpCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>